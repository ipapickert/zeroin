# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local SQLite database (file-based, created by migrate/seed).
# Der Ordner selbst bleibt versioniert (.gitkeep), weil `drizzle-kit push`
# ihn nicht anlegt und sonst nach dem Klonen fehlschlaegt.
/data/*
!/data/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Copy this file to `.env` if you want to override defaults.
# The app runs fine WITHOUT a .env — these are optional.

# Path to the SQLite database file (default: data/zeroin.db)
# ZEROIN_DB_PATH=data/zeroin.db

# Later course stages (AI repeat-defect detection) will add an API key here, e.g.:
# ANTHROPIC_API_KEY=sk-ant-...

# --- Hosted course instances only (e.g. CRHQ). Leave unset for local use. ---
# Signs the login cookie. Use a long random value on any public instance.
# SESSION_SECRET=
# Password for every seeded account (instead of the local default).
# SEED_PASSWORD=
# Public hostname(s) the dev server is reached through, comma-separated.
# ALLOWED_DEV_ORIGINS=example-zeroin.crhq.ai
